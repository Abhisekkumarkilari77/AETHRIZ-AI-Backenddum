NODE_ENV=development
PORT=3000

# Supabase server keys. Keep SUPABASE_SECRET_KEY private; never expose it to a frontend.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Where Supabase email links (verify / reset) send the user
APP_URL=http://localhost:3000
# Random 32+ char secret used to hash IPs before they are stored
IP_HASH_SALT=change-me-to-a-long-random-string

# Set to 1 when behind a single reverse proxy / load balancer
TRUST_PROXY=0
DOCS_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_15MIN=20

# Google Gemini AI (required only for AI analysis and food scan endpoints)

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
