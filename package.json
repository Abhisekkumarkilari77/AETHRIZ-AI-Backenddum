{
  "name": "aethriz-backend",
  "version": "0.1.0",
  "description": "AETHRIZ AI backend - Phase 1 foundation (Express + Supabase)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "npm run test:db && npm run test:api",
    "test:api": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:db": "node --test tests/db/*.test.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
